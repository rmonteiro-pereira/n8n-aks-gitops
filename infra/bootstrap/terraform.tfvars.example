# Copy to terraform.tfvars (git-ignored). The first three come from
#   tofu -chdir=../azure output
subscription_id     = "00000000-0000-0000-0000-000000000000"
resource_group_name = "rg-n8n-prod-eus2"
cluster_name        = "aks-n8n-prod-eus2"

gitops_repo_url = "https://github.com/your-org/n8n-aks-gitops.git"

